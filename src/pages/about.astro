---
import MainLayout from '../layouts/MainLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CTASection from '../components/CTASection.astro';
import { t } from '../i18n/ui';
const locale = 'en';
const dict = t(locale);
---
<MainLayout title={dict.pages.about.title} description={dict.pages.about.description} locale={locale} routeKey="about">
  <PageIntro eyebrow={dict.pages.about.heroEyebrow} title={dict.pages.about.heroTitle} copy={dict.pages.about.heroCopy} />
  <section class="section-sm">
    <div class="container grid grid-2">
      <article class="card" style="padding:2rem;">
        <h2>Our mission</h2>
        <p>To deliver trusted, practical cleaning services that help properties in Punta Cana stay ready, attractive, and professionally presented.</p>
      </article>
      <article class="card" style="padding:2rem;">
        <h2>How we work</h2>
        <p>We prioritize clear communication, efficient coordination, and careful execution so every property feels clean, controlled, and guest-ready.</p>
      </article>
    </div>
  </section>
  <CTASection locale={locale} />
</MainLayout>
