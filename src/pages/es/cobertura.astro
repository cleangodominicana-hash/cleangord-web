---
import MainLayout from '../../layouts/MainLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CoverageBlock from '../../components/CoverageBlock.astro';
import CTASection from '../../components/CTASection.astro';
import { siteSettings, t } from '../../i18n/ui';
const locale = 'es';
const dict = t(locale);
---
<MainLayout title={dict.pages.coverage.title} description={dict.pages.coverage.description} locale={locale} routeKey="coverage">
  <PageIntro eyebrow={dict.pages.coverage.heroEyebrow} title={dict.pages.coverage.heroTitle} copy={dict.pages.coverage.heroCopy} />
  <CoverageBlock locale={locale} />
  <section class="section-sm">
    <div class="container grid grid-2">
      <article class="card" style="padding:1.8rem;">
        <h2>Punta Cana</h2>
        <p>Apoyo de limpieza para alquileres vacacionales, villas, apartamentos y propiedades administradas.</p>
      </article>
      <article class="card" style="padding:1.8rem;">
        <h2>{siteSettings.areas.slice(1).join(', ')}</h2>
        <p>Cobertura cercana para clientes que necesitan rapidez, consistencia y coordinación sencilla.</p>
      </article>
    </div>
  </section>
  <CTASection locale={locale} />
</MainLayout>
