---
import MainLayout from '../../layouts/MainLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/ui';
const locale = 'es';
const dict = t(locale);
---
<MainLayout title={dict.pages.about.title} description={dict.pages.about.description} locale={locale} routeKey="about">
  <PageIntro eyebrow={dict.pages.about.heroEyebrow} title={dict.pages.about.heroTitle} copy={dict.pages.about.heroCopy} />
  <section class="section-shell pt-16 md:pt-20">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="card-surface h-full p-7 sm:p-8">
        <h2 class="text-2xl font-black text-brand-navy">Nuestra misión</h2>
        <p class="mt-4 text-base leading-7 text-brand-slate">Ofrecer servicios de limpieza confiables y prácticos que ayuden a las propiedades en Punta Cana a mantenerse listas, atractivas y bien presentadas.</p>
      </article>
      <article class="card-surface h-full p-7 sm:p-8">
        <h2 class="text-2xl font-black text-brand-navy">Cómo trabajamos</h2>
        <p class="mt-4 text-base leading-7 text-brand-slate">Priorizamos la comunicación clara, la coordinación eficiente y una ejecución cuidadosa para que cada propiedad se sienta limpia, controlada y lista para huéspedes.</p>
      </article>
    </div>
  </section>
  <CTASection locale={locale} />
</MainLayout>
