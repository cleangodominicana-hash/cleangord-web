---
import { ArrowRight, CheckCircle2, ClipboardCheck, MapPin, Users } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { getPath, getWhatsappUrl, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const page = dict.pages.airbnbService;
const content = dict.airbnbLanding;
const quoteUrl = `${getPath(locale, 'contact')}?service=airbnb-cleaning`;
const whatsappIcon = '/images/whatsapp.svg';
---

<section class="hero-grid border-b border-brand-border/70" data-analytics-location="airbnb_hero">
  <div class="section-shell grid gap-8 py-14 md:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div>
      <span class="eyebrow">{page.heroEyebrow}</span>
      <h1 class="mt-4 max-w-4xl text-4xl font-black tracking-tight text-brand-navy sm:text-5xl">{page.heroTitle}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-brand-slate">{page.heroCopy}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={getWhatsappUrl(locale, 'airbnb-cleaning')}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-brand-green px-6 py-3 text-center text-sm font-bold leading-5 text-brand-navy transition hover:bg-brand-navy hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-navy"
        >
          <img src={whatsappIcon} alt="" width="16" height="16" class="h-4 w-4 shrink-0 object-contain" aria-hidden="true" />
          <span>{dict.buttons.whatsappQuoteShort}</span>
        </a>
        <a
          href={quoteUrl}
          class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full border border-brand-navy px-6 py-3 text-center text-sm font-bold leading-5 text-brand-navy transition hover:bg-brand-navy hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-navy"
        >
          <span>{dict.buttons.requestQuote}</span>
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <aside class="rounded-[2rem] bg-brand-navy p-7 text-white shadow-[0_20px_60px_rgba(11,47,99,0.18)] sm:p-9">
      <Users class="h-8 w-8 text-brand-green" aria-hidden="true" />
      <h2 class="mt-5 text-2xl font-black">{content.audienceTitle}</h2>
      <p class="mt-4 text-base leading-7 text-white/80">{content.audienceCopy}</p>
    </aside>
  </div>
</section>

<section class="section-shell section-pad" aria-labelledby="airbnb-scope-title">
  <div class="max-w-3xl">
    <span class="eyebrow">{page.heroEyebrow}</span>
    <h2 id="airbnb-scope-title" class="mt-4 text-3xl font-black tracking-tight text-brand-navy sm:text-4xl">{content.scopeTitle}</h2>
    <p class="mt-4 text-lg leading-8 text-brand-slate">{content.scopeCopy}</p>
  </div>
  <div class="mt-10 grid gap-x-10 gap-y-7 md:grid-cols-2">
    {content.scopeItems.map((item) => (
      <article class="flex gap-4 border-t border-brand-border pt-6">
        <CheckCircle2 class="mt-1 h-6 w-6 shrink-0 text-brand-green" aria-hidden="true" />
        <div>
          <h3 class="text-xl font-bold text-brand-navy">{item.title}</h3>
          <p class="mt-2 text-base leading-7 text-brand-slate">{item.copy}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="border-y border-brand-border/70 bg-brand-soft/70">
  <div class="section-shell section-pad">
    <div class="max-w-3xl">
      <ClipboardCheck class="h-8 w-8 text-brand-green" aria-hidden="true" />
      <h2 class="mt-4 text-3xl font-black tracking-tight text-brand-navy sm:text-4xl">{content.coordinationTitle}</h2>
      <p class="mt-4 text-lg leading-8 text-brand-slate">{content.coordinationCopy}</p>
    </div>
    <ol class="mt-10 grid gap-6 lg:grid-cols-3">
      {content.coordinationSteps.map((step) => (
        <li class="card-surface h-full p-7">
          <h3 class="text-xl font-bold text-brand-navy">{step.title}</h3>
          <p class="mt-3 text-base leading-7 text-brand-slate">{step.copy}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section-shell section-pad">
  <div class="grid gap-6 lg:grid-cols-2">
    <article class="card-surface p-7 sm:p-8">
      <h2 class="text-2xl font-black text-brand-navy">{content.additionalTitle}</h2>
      <p class="mt-4 text-base leading-7 text-brand-slate">{content.additionalCopy}</p>
    </article>
    <article class="card-surface p-7 sm:p-8">
      <MapPin class="h-7 w-7 text-brand-green" aria-hidden="true" />
      <h2 class="mt-4 text-2xl font-black text-brand-navy">{content.coverageTitle}</h2>
      <p class="mt-4 text-base leading-7 text-brand-slate">{content.coverageCopy}</p>
      <a
        href={getPath(locale, 'coverage')}
        class="mt-5 inline-flex items-center gap-2 rounded-sm text-sm font-bold text-brand-navy underline decoration-brand-green decoration-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-navy"
      >
        {dict.buttons.viewCoverage}
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </article>
  </div>
</section>

<section class="section-shell pb-16 md:pb-20" data-analytics-location="airbnb_cta">
  <div class="rounded-[2rem] bg-brand-navy px-6 py-10 text-white shadow-[0_22px_70px_rgba(11,47,99,0.2)] sm:px-10 lg:px-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-black tracking-tight">{content.finalTitle}</h2>
        <p class="mt-3 text-lg leading-8 text-white/75">{content.finalCopy}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <a
          href={getWhatsappUrl(locale, 'airbnb-cleaning')}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-brand-green px-6 py-3 text-center text-sm font-bold leading-5 text-brand-navy transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <img src={whatsappIcon} alt="" width="16" height="16" class="h-4 w-4 shrink-0 object-contain" aria-hidden="true" />
          <span>{dict.buttons.whatsappQuoteShort}</span>
        </a>
        <a
          href={quoteUrl}
          class="inline-flex min-h-14 items-center justify-center rounded-full border border-white/40 px-6 py-3 text-center text-sm font-bold leading-5 text-white transition hover:border-white hover:bg-white hover:text-brand-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {dict.buttons.requestQuote}
        </a>
      </div>
    </div>
  </div>
</section>
