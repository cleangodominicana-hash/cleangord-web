---
import {
  ExternalLink,
  Mail,
  MapPin,
  MessageCircleMore,
  PhoneCall
} from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { getPath, getWhatsappUrl, siteSettings, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const privacyLabel = locale === 'es' ? 'Política de privacidad (borrador)' : 'Privacy policy (draft)';
---

<footer class="mt-16 bg-brand-navy text-white" data-analytics-location="footer">
  <div class="section-shell grid gap-12 py-14 lg:grid-cols-[1.2fr_0.9fr_0.9fr_1fr]">
    <div class="space-y-5">
      <div>
        <p class="text-3xl font-black tracking-tight">
          Clean<span class="text-brand-green">Go</span>
        </p>
        <p class="mt-2 max-w-sm text-sm leading-6 text-white/75">
          {dict.description}
        </p>
      </div>

      <div class="flex items-center gap-3 text-white/80">
        <a
          href={siteSettings.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="rounded-full border border-white/15 p-2 hover:text-brand-green"
        >
          <ExternalLink class="h-4 w-4" />
        </a>

        <a
          href={siteSettings.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="rounded-full border border-white/15 p-2 hover:text-brand-green"
        >
          <Mail class="h-4 w-4" />
        </a>

        <a
          href={getWhatsappUrl(locale)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="rounded-full border border-white/15 p-2 hover:text-brand-green"
        >
          <MessageCircleMore class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        Navigation
      </h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        {dict.nav.map((item) => (
          <li>
            <a href={getPath(locale, item.key)} class="hover:text-brand-green">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        Coverage
      </h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        {siteSettings.areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        Contact
      </h2>
      <ul class="mt-5 space-y-4 text-sm text-white/85">
        <li class="flex items-start gap-3">
          <PhoneCall class="mt-0.5 h-4 w-4 text-brand-green" />
          <a href={siteSettings.phoneHref}>{siteSettings.phoneDisplay}</a>
        </li>

        <li class="flex items-start gap-3">
          <Mail class="mt-0.5 h-4 w-4 text-brand-green" />
          <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
        </li>

        <li class="flex items-start gap-3">
          <MapPin class="mt-0.5 h-4 w-4 text-brand-green" />
          <span>{siteSettings.address}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="section-shell flex flex-col gap-3 py-4 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 CleanGo. All rights reserved.</p>
      <a href={getPath(locale, 'privacy')} class="underline-offset-4 hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        {privacyLabel}
      </a>
      <p>{siteSettings.schedule}</p>
    </div>
  </div>
</footer>
