---
import {
  ExternalLink,
  Mail,
  MapPin,
  PhoneCall
} from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { getPath, getWhatsappUrl, siteSettings, socialLinks, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const privacyLabel = locale === 'es' ? 'Política de privacidad' : 'Privacy policy';
const whatsappIcon = '/images/whatsapp.svg';
---

<footer class="mt-16 bg-brand-navy text-white" data-analytics-location="footer">
  <div class="section-shell grid gap-12 py-14 lg:grid-cols-[1.2fr_0.9fr_0.9fr_1fr]">
    <div class="space-y-5">
      <div>
        <p class="text-3xl font-black tracking-tight">
          Clean<span class="text-brand-green">Go</span>
        </p>
        <p class="mt-2 max-w-sm text-sm leading-6 text-white/75">
          {dict.description}
        </p>
      </div>

      <div class="flex items-center gap-3 text-white/80">
        {socialLinks.map(([name, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={name === 'facebook' ? 'Facebook' : 'Instagram'}
            class="inline-flex items-center justify-center rounded-full border border-white/15 p-2 hover:text-brand-green"
          >
            <ExternalLink class="h-4 w-4 shrink-0" />
          </a>
        ))}

        <a
          href={getWhatsappUrl(locale)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="inline-flex items-center justify-center rounded-full border border-white/15 p-2 hover:text-brand-green"
        >
          <img src={whatsappIcon} alt="" width="16" height="16" class="h-4 w-4 shrink-0 object-contain" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        {dict.footer.navigation}
      </h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        {dict.nav.map((item) => (
          <li>
            <a href={getPath(locale, item.key)} class="hover:text-brand-green">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        {dict.footer.coverage}
      </h2>
      <ul class="mt-5 space-y-3 text-sm text-white/85">
        {siteSettings.areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-white/70">
        {dict.footer.contact}
      </h2>
      <ul class="mt-5 space-y-4 text-sm text-white/85">
        <li class="flex items-start gap-3">
          <PhoneCall class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" aria-hidden="true" />
          <a href={siteSettings.phoneHref}>{siteSettings.phoneDisplay}</a>
        </li>

        <li class="flex items-start gap-3">
          <Mail class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" aria-hidden="true" />
          <a class="break-all" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
        </li>

        <li class="flex items-start gap-3">
          <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" aria-hidden="true" />
          <span>{dict.footer.address}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="section-shell flex flex-col gap-3 py-4 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>{dict.footer.copyright}</p>
      <a href={getPath(locale, 'privacy')} class="self-start underline-offset-4 hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:self-auto">
        {privacyLabel}
      </a>
      <p>{dict.footer.schedule}</p>
    </div>
  </div>
</footer>
