---
import { Camera, ScanSearch } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const backgrounds = ['before-after-image', 'before-after-kitchen', 'before-after-bathroom'];
---

<section class="section-pad">
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">{dict.beforeAfter.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-black tracking-tight text-brand-navy sm:text-4xl">{dict.beforeAfter.title}</h2>
      <p class="mt-4 text-lg leading-8 text-brand-slate">{dict.beforeAfter.copy}</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {dict.beforeAfter.items.map((item, index) => (
        <article class="card-surface overflow-hidden">
          <div class:list={[backgrounds[index] ?? 'before-after-image', 'relative aspect-[4/3]']}>
            <div class="absolute inset-0 bg-brand-navy/30"></div>
            <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-2 text-xs font-bold uppercase tracking-[0.18em] text-brand-navy">
              <Camera class="h-4 w-4 text-brand-green" /> {item.label}
            </div>
            <div class="absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl bg-white/92 px-4 py-3 backdrop-blur">
              <span class="text-sm font-semibold text-brand-slate">{item.before}</span>
              <span class="inline-flex rounded-full bg-brand-green p-2 text-brand-navy"><ScanSearch class="h-4 w-4" /></span>
              <span class="text-sm font-semibold text-brand-navy">{item.after}</span>
            </div>
          </div>
          <div class="p-6">
            <p class="text-base leading-7 text-brand-slate">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
