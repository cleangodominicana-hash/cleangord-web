---
import { MessageCircleMore } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { getWhatsappUrl, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="section-shell section-pad" data-analytics-location="cta_section">
  <div class="overflow-hidden rounded-[2rem] bg-brand-navy px-6 py-10 text-white shadow-[0_22px_70px_rgba(11,47,99,0.2)] sm:px-10 lg:px-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-3xl font-black tracking-tight">{dict.cta.title}</p>
        <p class="mt-3 text-lg leading-8 text-white/75">{dict.cta.copy}</p>
      </div>
      <a
        href={getWhatsappUrl(locale)}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-green px-6 py-4 text-sm font-bold text-white transition hover:bg-white hover:text-brand-navy"
      >
        <MessageCircleMore class="h-4 w-4" />
        {dict.buttons.whatsapp}
      </a>
    </div>
  </div>
</section>
