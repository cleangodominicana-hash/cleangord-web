---
import { ArrowRight, BadgeCheck, Clock3, MessageCircleMore, PhoneCall, ShieldCheck } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { getPath, getWhatsappUrl, siteSettings, t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const benefitIcons = [Clock3, ShieldCheck, BadgeCheck];
---

<section class="hero-grid overflow-hidden border-b border-brand-border/70">
  <div class="section-shell section-pad grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr]">
    <div class="space-y-8">
      <div class="space-y-5">
        <span class="eyebrow">{dict.hero.eyebrow}</span>
        <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight text-brand-navy sm:text-5xl lg:text-6xl">
          {dict.hero.title}
        </h1>
        <p class="max-w-2xl text-lg leading-8 text-brand-slate">
          {dict.hero.copy}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {dict.hero.benefits.map((benefit, index) => {
          const Icon = benefitIcons[index] ?? BadgeCheck;
          return (
            <div class="rounded-3xl border border-brand-border bg-white/90 p-5 shadow-sm">
              <Icon class="h-6 w-6 text-brand-green" />
              <h2 class="mt-4 text-base font-bold text-brand-navy">{benefit.title}</h2>
              <p class="mt-2 text-sm leading-6 text-brand-slate">{benefit.copy}</p>
            </div>
          );
        })}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={getWhatsappUrl(locale)}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-green px-6 py-4 text-sm font-bold text-white transition hover:bg-brand-navy"
        >
          <MessageCircleMore class="h-4 w-4" />
          {dict.buttons.whatsapp}
        </a>
        <a
          href={siteSettings.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-navy px-6 py-4 text-sm font-bold text-brand-navy transition hover:bg-brand-navy hover:text-white"
        >
          <PhoneCall class="h-4 w-4" />
          {dict.buttons.callNow}
        </a>
        <a
          href={getPath(locale, 'services')}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-border px-6 py-4 text-sm font-bold text-brand-slate transition hover:border-brand-blue hover:text-brand-blue"
        >
          {dict.buttons.viewServices}
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="card-surface overflow-hidden rounded-4xl">
        <div class="relative aspect-[4/4.2] w-full overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1400&q=80"
            alt="Bright and spotless property in Punta Cana"
            class="h-full w-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-linear-to-t from-brand-navy/40 via-transparent to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5 grid gap-4 sm:grid-cols-2">
            {dict.hero.stats.map((item) => (
              <div class="rounded-3xl border border-white/15 bg-white/90 p-5 backdrop-blur">
                <p class="text-lg font-black text-brand-navy">{item.title}</p>
                <p class="mt-1 text-sm text-brand-slate">{item.copy}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="absolute -left-4 -top-4 hidden rounded-3xl bg-brand-navy px-5 py-4 text-white shadow-xl lg:block">
        <p class="text-xs uppercase tracking-[0.2em] text-white/60">Coverage</p>
        <p class="mt-1 text-lg font-bold">{siteSettings.areas.join(' · ')}</p>
      </div>
    </div>
  </div>
</section>
