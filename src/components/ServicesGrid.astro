---
import { BedDouble, Building2, CalendarClock, House, Sparkles, Wrench } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const icons = [BedDouble, House, Building2, Sparkles, CalendarClock, Wrench];
---

<section class="section-pad">
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">{dict.servicesSection.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-black tracking-tight text-brand-navy sm:text-4xl">{dict.servicesSection.title}</h2>
      <p class="mt-4 text-lg leading-8 text-brand-slate">{dict.servicesSection.copy}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {dict.services.map((service, index) => {
        const Icon = icons[index] ?? Sparkles;
        return (
          <article class="card-surface p-7 transition duration-200 hover:-translate-y-1 hover:border-brand-green/40">
            <div class="inline-flex rounded-2xl bg-brand-mint p-3 text-brand-green">
              <Icon class="h-7 w-7" />
            </div>
            <h3 class="mt-5 text-xl font-bold text-brand-navy">{service.title}</h3>
            <p class="mt-3 text-base leading-7 text-brand-slate">{service.description}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
