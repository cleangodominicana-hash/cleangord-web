---
import { Cookie } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import { analyticsConfig } from '../config/analytics';
import { getPath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'es'
  ? {
      title: 'Usamos cookies',
      description: 'Utilizamos cookies de terceros de analítica para mantener una buena experiencia en nuestro sitio.',
      accept: 'Aceptar',
      reject: 'Rechazar',
      settings: 'Preferencias de analítica',
      privacy: 'Política de privacidad'
    }
  : {
      title: 'We use cookies',
      description: 'We use third-party analytics cookies to maintain a good experience on our website.',
      accept: 'Accept',
      reject: 'Reject',
      settings: 'Analytics settings',
      privacy: 'Privacy policy'
    };
const privacyPath = getPath(locale, 'privacy');
---

<section
  id="analytics-consent"
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-[100] max-h-[calc(100dvh-1.5rem)] overflow-y-auto rounded-3xl border border-white/15 bg-brand-navy p-4 text-white shadow-2xl sm:inset-x-auto sm:left-4 sm:w-[min(24rem,calc(100vw-2rem))] sm:p-5"
  role="dialog"
  aria-modal="false"
  aria-live="polite"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  data-analytics-consent
  hidden
>
  <div class="flex items-start gap-3">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-green">
      <Cookie class="h-5 w-5" aria-hidden="true" />
    </span>
    <div class="min-w-0">
      <h2 id="analytics-consent-title" class="text-base font-bold text-white">{copy.title}</h2>
      <p id="analytics-consent-description" class="mt-1.5 text-sm leading-5 text-white/80">{copy.description}</p>
    </div>
  </div>
  <a href={privacyPath} class="mt-3 inline-block cursor-pointer text-sm font-semibold text-white underline decoration-white/50 underline-offset-4 hover:text-brand-green focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
    {copy.privacy}
  </a>
  <div class="mt-4 grid grid-cols-2 gap-3">
    <button type="button" class="min-h-11 cursor-pointer rounded-full bg-brand-green px-4 py-2.5 text-sm font-bold text-brand-navy hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-pressed="false" data-analytics-accept>
      {copy.accept}
    </button>
    <button type="button" class="min-h-11 cursor-pointer rounded-full border border-white/40 px-4 py-2.5 text-sm font-bold text-white hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-pressed="false" data-analytics-reject>
      {copy.reject}
    </button>
  </div>
</section>

<button
  type="button"
  class="fixed right-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-[90] inline-flex h-11 w-11 cursor-pointer items-center justify-center gap-2 rounded-full border border-white/15 bg-brand-navy text-xs font-semibold text-white shadow-lg hover:bg-brand-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-navy sm:right-4 sm:h-auto sm:w-auto sm:px-4 sm:py-2.5"
  aria-controls="analytics-consent"
  aria-expanded="false"
  aria-label={copy.settings}
  data-analytics-settings
>
  <Cookie class="h-4 w-4 shrink-0" aria-hidden="true" />
  <span class="hidden sm:inline">{copy.settings}</span>
</button>

<script is:inline define:vars={{ measurementId: analyticsConfig.measurementId, consentKey: analyticsConfig.consentStorageKey }}>
  (() => {
    const granted = 'granted';
    const denied = 'denied';
    const disableKey = `ga-disable-${measurementId}`;
    const banner = document.querySelector('[data-analytics-consent]');
    const acceptButton = document.querySelector('[data-analytics-accept]');
    const rejectButton = document.querySelector('[data-analytics-reject]');
    const settingsButton = document.querySelector('[data-analytics-settings]');

    const readStoredPreference = () => {
      try {
        const value = localStorage.getItem(consentKey);
        return value === granted || value === denied ? value : null;
      } catch {
        return null;
      }
    };

    let currentPreference = readStoredPreference();
    const getPreference = () => currentPreference;

    const updatePreferenceState = () => {
      acceptButton?.setAttribute('aria-pressed', String(currentPreference === granted));
      rejectButton?.setAttribute('aria-pressed', String(currentPreference === denied));
    };

    const savePreference = (value) => {
      currentPreference = value;
      updatePreferenceState();
      try {
        localStorage.setItem(consentKey, value);
      } catch {
        // The current page can still honor the choice when storage is unavailable.
      }
    };

    const setBannerOpen = (open, focusChoice = false) => {
      if (!banner || !settingsButton) return;
      banner.hidden = !open;
      settingsButton.hidden = open;
      settingsButton.setAttribute('aria-expanded', String(open));
      if (open && focusChoice) acceptButton?.focus();
    };

    const analyticsScript = () => document.querySelector(`script[data-ga4-id="${measurementId}"]`);

    const clearAnalyticsCookies = () => {
      const cookieNames = document.cookie
        .split(';')
        .map((cookie) => cookie.trim().split('=')[0])
        .filter((name) => name === '_ga' || name === '_gid' || name.startsWith('_ga_') || name.startsWith('_gat') || name.startsWith('_gac_'));
      const apexDomain = location.hostname.replace(/^www\./, '');
      const attributes = `; Max-Age=0; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;

      cookieNames.forEach((name) => {
        document.cookie = `${name}=${attributes}`;
        document.cookie = `${name}=${attributes}; Domain=${location.hostname}`;
        if (apexDomain !== location.hostname) document.cookie = `${name}=${attributes}; Domain=${apexDomain}`;
      });
    };

    const createGtag = () => {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
    };

    const enableAnalytics = () => {
      window[disableKey] = false;
      createGtag();

      if (analyticsScript()) {
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        return;
      }

      window.gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      window.gtag('js', new Date());
      window.gtag('config', measurementId);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.dataset.ga4Id = measurementId;
      document.head.append(script);
    };

    const disableAnalytics = () => {
      window[disableKey] = true;
      if (analyticsScript() && typeof window.gtag === 'function') {
        window.gtag('consent', 'update', { analytics_storage: 'denied' });
      }
      clearAnalyticsCookies();
    };

    acceptButton?.addEventListener('click', () => {
      savePreference(granted);
      enableAnalytics();
      setBannerOpen(false);
      settingsButton?.focus();
    });

    rejectButton?.addEventListener('click', () => {
      savePreference(denied);
      disableAnalytics();
      setBannerOpen(false);
      settingsButton?.focus();
    });

    settingsButton?.addEventListener('click', () => setBannerOpen(true, true));

    document.addEventListener('click', (event) => {
      if (getPreference() !== granted || window[disableKey] || typeof window.gtag !== 'function') return;
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest('a[href]');
      if (!link) return;

      const href = link.getAttribute('href') || '';
      let contactMethod;
      if (href.startsWith('tel:')) contactMethod = 'phone';
      else if (href.startsWith('mailto:')) contactMethod = 'email';
      else {
        try {
          if (new URL(link.href).hostname === 'wa.me') contactMethod = 'whatsapp';
        } catch {
          return;
        }
      }

      const ctaLocation = link.closest('[data-analytics-location]')?.getAttribute('data-analytics-location');
      if (!contactMethod || !ctaLocation) return;

      window.gtag('event', 'contact_click', {
        contact_method: contactMethod,
        page_language: document.documentElement.lang === 'es' ? 'es' : 'en',
        cta_location: ctaLocation
      });
    });

    updatePreferenceState();
    if (getPreference() === granted) enableAnalytics();
    else {
      disableAnalytics();
      setBannerOpen(getPreference() === null);
    }
  })();
</script>
